# Copy to .env and fill in. Never commit .env.

# Tiger Data (TimescaleDB)
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com   # replace with a provider key; public devnet rate-limits hard
AUSD_MINT=
SQUADS_MULTISIG=
SQUADS_VAULT=
BOND_MINT=
BOT_KEYPAIR_PATH=./secrets/bot.json             # keep keypairs outside the repo or in git-ignored secrets/
MINT_AUTHORITY_KEYPAIR_PATH=./secrets/mint-authority.json

# Replay
REPLAY_SECONDS=90
DEMO_MODE=true                                  # waiting period 0, Start/Reset buttons visible

# Hosting
PUBLIC_BASE_URL=https://example.com             # the GoDaddy domain on Vultr

# USGS (optional): a free key for api.waterdata.usgs.gov raises its rate limit
USGS_API_KEY=

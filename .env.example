# Copy to .env at the repo root and fill in. Never commit .env.
# The web app has its own file: web/.env.example -> web/.env.local

# Tiger Data (TimescaleDB), shared by the engine and the chain side
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com   # server side only: Helius devnet URL, e.g. https://devnet.helius-rpc.com/?api-key=...
# optional, browser bundle (public!): a separate key locked to your domain; empty = public devnet
WEB_RPC_URL=
SECRETS_DIR=secrets                             # keypairs, git-ignored
CHAIN_STATE_FILE=chain/state/devnet.json        # public addresses written by the setup scripts
PRIORITY_MICROLAMPORTS=10000
SQUADS_TIMELOCK_SECONDS=60                      # demo mode; applies to every vault proposal

# Shared admin token (plan v3 9.3): /replay/* on the engine, /chain/reset on the chain service.
ADMIN_TOKEN=change-me

# Chain service (Jesse)
CHAIN_PORT=8787
CHAIN_HOST=127.0.0.1                            # keep on localhost; the gateway is the public entry point
GATEWAY_PORT=8080                               # what cloudflared exposes
PUBLIC_BASE_URL=https://example.com             # the domain or trycloudflare URL; used in policy metadata URIs and the Blink icon
PURCHASE_FLOW=a                                 # a or b, from the Phantom phone test (plan v3.1 8.3)
# comma-separated allowlist for buy and bond in demo mode
DEMO_WALLETS=
SNAPSHOT_VAULT=5300                             # reset refills the vault up to this (reserve 300 + bond 5000)
SNAPSHOT_FLOAT=2000                             # reset refills the bot float up to this
FALLBACK_PREMIUM=48                             # demo only, if the engine's /quote is down
DEFAULT_PAYOUT=500
PAYOUT_OPTIONS=250,500                          # the only payouts the buy endpoints accept (the dashboard offers these)
MAX_BOND_DEPOSIT=100000                         # largest single bond deposit in aUSD
MAX_DONATION=2000                               # largest single sponsor donation in aUSD (docs/readiness.md)
BOT_POLL_MS=2000

# Engine (Ezekiel)
ENGINE_URL=http://127.0.0.1:8000
REPLAY_SECONDS=90
DEMO_MODE=true                                  # waiting period 0, demo allowlist on (Start/Reset need ADMIN_TOKEN)
CHAIN_URL=http://127.0.0.1:8787                 # the engine reads /chain/balances and calls /chain/reset here
SEED_RESERVE=300                                # the seeded reserve inside SNAPSHOT_VAULT; the rest is seeded bond capital
# optional: external streamer instead of the built-in one (gets RUN_ID)
REPLAY_CMD=
REPLAY_MAX_JUMP_FT=5                            # data-quality guard, per 15 minutes
# true-up rehearsal only, e.g. 0.6; leave empty for the demo
FORCE_F_INT=
ENGINE_CORS_ORIGINS=*                           # comma-separated; the hosted site is same-origin through the gateway
# Replay window (engine/README.md): searched in REPLAY_SEARCH_START..END (default 2017-08-23..2017-09-05),
# or fixed with REPLAY_WINDOW_START / REPLAY_WINDOW_END (ISO times; no timezone = UTC)
# Pricing (engine/README.md); defaults shown
# PRICING_THETA=0.35  PRICING_C=0.06  PRICING_E=0.10  MIN_PREMIUM=1  HARVEY_WATER_YEAR=2017
# BOOTSTRAP_N=2000  NEAR_FRACTION=0.9

# USGS (optional): a free key for api.waterdata.usgs.gov raises its rate limit
USGS_API_KEY=

# Policy term in days, read by both the chain and the engine (premium = one payment for the term).
# Don't set TERM_YEARS: the engine derives it, and preflight fails if the two sides disagree.
TERM_DAYS=90
# Replay only the demo_ready gauges (true/false)
REPLAY_DEMO_ONLY=true

# Readiness Markets (docs/readiness.md). Demo sizing: SNAPSHOT_VAULT=1000, SEED_RESERVE=300.
READINESS_PRICING=false                         # true: the price falls as community money funds the pool
SIM_HOUSEHOLDS=500                              # assumed households per simulated market (gap to launch)

# Copy to .env at the repo root and fill in. Never commit .env.
# The web app has its own file: web/.env.example -> web/.env.local

# Tiger Data (TimescaleDB), shared by the engine and the chain side
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com   # server side only: Helius devnet URL, e.g. https://devnet.helius-rpc.com/?api-key=...
WEB_RPC_URL=                                    # optional, browser bundle (public!): a separate key locked to your domain; empty = public devnet
SECRETS_DIR=secrets                             # keypairs, git-ignored
CHAIN_STATE_FILE=chain/state/devnet.json        # public addresses written by the setup scripts
PRIORITY_MICROLAMPORTS=10000
SQUADS_TIMELOCK_SECONDS=60                      # demo mode; applies to every vault proposal

# Shared admin token (plan v3 9.3): /replay/* on the engine, /chain/reset on the chain service.
ADMIN_TOKEN=change-me

# Chain service (Jesse)
CHAIN_PORT=8787
CHAIN_HOST=127.0.0.1                            # keep on localhost; the gateway is the public entry point
GATEWAY_PORT=8080                               # what cloudflared exposes
PUBLIC_BASE_URL=https://example.com             # the domain or trycloudflare URL; used in policy metadata URIs and the Blink icon
PURCHASE_FLOW=a                                 # a or b, from the Hour-0 Phantom test (plan v3 8.3)
DEMO_WALLETS=                                   # comma-separated allowlist for buy and bond in demo mode
SNAPSHOT_VAULT=5300                             # reset refills the vault up to this (reserve 300 + bond 5000)
SNAPSHOT_FLOAT=2000                             # reset refills the bot float up to this
FALLBACK_PREMIUM=48                             # demo only, if the engine's /quote is down
DEFAULT_PAYOUT=500
BOT_POLL_MS=2000

# Engine (Ezekiel)
ENGINE_URL=http://localhost:8000
REPLAY_SECONDS=90
DEMO_MODE=true                                  # waiting period 0, demo allowlist on (Start/Reset need ADMIN_TOKEN)
CHAIN_URL=http://127.0.0.1:8787                 # the engine reads /chain/balances and calls /chain/reset here
SEED_RESERVE=300                                # the seeded reserve inside SNAPSHOT_VAULT; the rest is seeded bond capital
REPLAY_CMD=                                     # optional: external streamer instead of the built-in one (gets RUN_ID)
REPLAY_MAX_JUMP_FT=5                            # data-quality guard, per 15 minutes
FORCE_F_INT=                                    # true-up rehearsal only, e.g. 0.6; leave empty for the demo
# Pricing (engine/README.md); defaults shown
# PRICING_THETA=0.35  PRICING_C=0.06  PRICING_E=0.10  TERM_YEARS=1  MIN_PREMIUM=1  HARVEY_WATER_YEAR=2017

# USGS (optional): a free key for api.waterdata.usgs.gov raises its rate limit
USGS_API_KEY=

# Policy term. The premium is one payment for the whole term. Engine TERM_YEARS = TERM_DAYS / 365 (default 90 days).
TERM_DAYS=90
TERM_YEARS=0.2466

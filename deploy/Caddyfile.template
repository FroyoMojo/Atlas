# Atlas on one Vultr box (plan v3.1 section 9). Rendered by setup-server.sh / deploy.sh:
# __HOSTS__ becomes "your-domain.com, 203-0-113-5.sslip.io" (domain plus the sslip.io fallback).
__HOSTS__ {
	encode gzip

	# /chain/reset is localhost-only in code too; never reachable from outside.
	@reset path /chain/reset
	respond @reset 403

	# Engine (Ezekiel's FastAPI) under /engine; prefix stripped. X-Admin-Token passes through.
	handle_path /engine/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Chain service (Jesse).
	@chain path /api/* /policies /policies/* /chain/* /terms/* /actions.json /icon.svg /health
	handle @chain {
		reverse_proxy 127.0.0.1:8787
	}

	# Dashboard and phone view (static Vite build; hash routes, so index.html for everything else).
	handle {
		root * __ROOT__/web/dist
		try_files {path} /index.html
		file_server
	}
}

# Template for Ezekiel's FastAPI. Adjust ExecStart to the real module path, then:
#   sudo cp deploy/systemd/atlas-engine.service /etc/systemd/system/ && sudo systemctl enable --now atlas-engine
[Unit]
Description=Atlas engine (FastAPI, read-only API, replay orchestration)
After=network-online.target
Wants=network-online.target

[Service]
User=atlas
WorkingDirectory=/opt/atlas/engine
EnvironmentFile=/opt/atlas/.env
ExecStart=/opt/atlas/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

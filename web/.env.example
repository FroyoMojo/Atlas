# Copy to web/.env.local. Vite only exposes variables prefixed with VITE_.
VITE_USE_MOCKS=true                       # true until Ezekiel's engine is up
VITE_ENGINE_URL=http://localhost:8000     # FastAPI (Ezekiel)
VITE_CHAIN_URL=http://localhost:8787      # chain server (npm run server in /chain)
VITE_RPC_URL=https://api.devnet.solana.com
VITE_AUSD_MINT=                           # from chain/state/devnet.json
VITE_DEMO_MODE=true                       # shows Start / Reset replay buttons
VITE_EXPLORER_CLUSTER=devnet

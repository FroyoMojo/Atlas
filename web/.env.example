# Copy to web/.env.local for `npm run dev`. Vite only exposes variables prefixed with VITE_.
# For the hosted build leave ENGINE/CHAIN unset: the dashboard then calls its own origin
# (/engine/... and the chain routes) through the gateway, on the tunnel URL or the domain.
VITE_USE_MOCKS=true                       # false once Ezekiel's engine is up
VITE_ENGINE_URL=http://localhost:8000     # dev only
VITE_CHAIN_URL=http://localhost:8787      # dev only
VITE_RPC_URL=https://api.devnet.solana.com
VITE_AUSD_MINT=                           # from chain/state/devnet.json
VITE_EXPLORER_CLUSTER=devnet
VITE_PURCHASE_FLOW=a                      # a or b, from the phone test (plan v3.1 8.3)
